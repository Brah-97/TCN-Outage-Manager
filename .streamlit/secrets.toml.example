# Copy this file to .streamlit/secrets.toml and fill in your project's values.
# secrets.toml is git-ignored. Never commit the real key.
#
# Supabase dashboard → Project Settings → API:
#   SUPABASE_URL = the "Project URL"
#   SUPABASE_KEY = the SECRET key (service_role / sb_secret_...), NOT the
#                  publishable / anon key. The app runs server-side, and the
#                  tables have Row Level Security that blocks the public key.

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "paste-your-secret-key-here"
